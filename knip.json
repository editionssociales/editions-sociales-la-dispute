{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "scripts/*.{ts,mjs}",
    "scripts/migrate-catalogue/index.ts",
    "src/migrations/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "tsx",
    "tailwindcss"
  ]
}
