# ─────────────────────────────────────────────────────────────────────────────
# V1 — WordPress « headless ».
# Le site lit les catalogues via l'API REST des WordPress existants et la
# boutique via la WooCommerce Store API (publique). Aucun accès direct aux bases
# OVH n'est requis → déployable tel quel sur Vercel.
#
# Prérequis côté WordPress : déposer `wp-headless/es-headless-rest.php` dans
# wp-content/mu-plugins/ de editionssociales.fr et ladispute.fr (expose les
# taxonomies + champs ACF en REST). La boutique ne nécessite aucune modification.
# ─────────────────────────────────────────────────────────────────────────────

WP_ES_URL=https://editionssociales.fr
WP_LD_URL=https://ladispute.fr
WC_STORE_URL=https://boutique.editionssociales.fr

# Durée de revalidation du cache HTTP (secondes).
WP_REVALIDATE=3600

# ─────────────────────────────────────────────────────────────────────────────
# (Optionnel / legacy) Accès direct aux bases OVH — NON utilisé en V1 headless.
# Réservé à un dev local avec les dumps chargés dans une MariaDB (src/lib/db.ts).
# Les hôtes *.mysql.db ne sont joignables que depuis le réseau OVH.
# ─────────────────────────────────────────────────────────────────────────────
# CATALOG_ES_HOST=127.0.0.1
# CATALOG_ES_PORT=3307
# CATALOG_ES_USER=root
# CATALOG_ES_PASSWORD=
# CATALOG_ES_DATABASE=editionskes
# CATALOG_ES_PREFIX=es_
